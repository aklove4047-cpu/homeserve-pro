{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homeserve-pro",
  "main": "src/index.js",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "homeserve-db",
      "database_id": "58adff94-6812-45dd-a074-80c34c41397e"
    }
  ]
}
